# Copy to .env and fill real values
#
# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
HEARTBEAT_LOG=true

# Enable potentially sensitive debug endpoints (e.g. /api/debug-groq)
# In production this defaults to false unless explicitly enabled.
ENABLE_DEBUG_ENDPOINTS=false

# AI Providers (at least one of OpenAI or Gemini recommended)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# Groq (used by /api/simple-chat and "simple:" prefix)
GROQ_API_KEY=gsk_your_groq_key_here

# YouTube Data API (optional but recommended for reliable results)
YOUTUBE_API_KEY=your-youtube-key-here
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# Spotify OAuth (optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
